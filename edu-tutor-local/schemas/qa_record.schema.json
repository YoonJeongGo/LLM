{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "concept": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "problem_family_id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "train",
        "validation",
        "test",
        "fixture"
      ]
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "role",
          "content"
        ]
      },
      "minItems": 2
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "self_authored_demo",
            "user_authorized",
            "open_licensed"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "rights_note": {
          "type": "string",
          "minLength": 1
        },
        "created_by": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "title",
        "rights_note",
        "created_by"
      ]
    },
    "review_status": {
      "enum": [
        "generated_unreviewed",
        "human_reviewed",
        "rejected"
      ]
    },
    "demo_only": {
      "type": "boolean"
    },
    "sql_dialect": {
      "enum": [
        "sqlite",
        "oracle",
        "postgresql",
        "mysql",
        "sqlserver",
        "none"
      ]
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tables": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "columns": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                    },
                    "type": {
                      "enum": [
                        "INTEGER",
                        "TEXT",
                        "REAL"
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "type"
                  ]
                },
                "minItems": 1
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  }
                }
              }
            },
            "required": [
              "name",
              "columns",
              "rows"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "tables"
      ]
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sql": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          }
        },
        "row_order": {
          "enum": [
            "ordered",
            "multiset"
          ]
        },
        "numeric_abs_tolerance": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "sql",
        "columns",
        "rows",
        "row_order",
        "numeric_abs_tolerance"
      ]
    },
    "verification_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "id",
    "subject",
    "concept",
    "difficulty",
    "problem_family_id",
    "split",
    "messages",
    "source",
    "review_status",
    "demo_only"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:edu-tutor:qa-record:1",
  "title": "교육 예제 v1"
}
